# ---------------------------------------------------------------------------
# MySmartCard Campus — environment variables
# Copy to .env.local for development. In production set these in your host's
# secret manager (e.g. `vercel env add`). Never commit real values.
# ---------------------------------------------------------------------------

# REQUIRED in production: 32+ random characters. Encrypts stored NFC card
# tokens and one-time credential notices. Rotating it invalidates stored card
# tokens (rotate all card URLs afterwards). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=

# Public base URL used when building NFC card URLs (https in production).
APP_URL=http://localhost:3000

# PostgreSQL connection string (Neon, Supabase, RDS, …). If unset, the app uses
# an embedded PGlite database in ./.data (development / demos only).
DATABASE_URL=
DB_POOL_MAX=10

# Optional: subdomain tenant routing, e.g. ROOT_DOMAIN=campus.example.com makes
# northbridge.campus.example.com serve the "northbridge" workspace.
ROOT_DOMAIN=
# Share the session cookie across tenant subdomains, e.g. .campus.example.com
COOKIE_DOMAIN=

# Optional: private file storage location for the local-disk adapter.
STORAGE_DIR=

# Optional: email provider for notice notifications. Unset = notices are still
# published in the portal; email requests are recorded as "skipped_unconfigured".
EMAIL_PROVIDER=

# Allow the embedded database / demo seed in a production build (demo hosts only).
ALLOW_EMBEDDED_DB=
ALLOW_DEMO_SEED=

# Required on Vercel: authorizes the daily data-retention cron (/api/cron/retention).
CRON_SECRET=
